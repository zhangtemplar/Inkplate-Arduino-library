    }

    showStatus("Config mode", line1, line2, line3);
}

void scanPhotosInDir(const String &dirPath, uint8_t depth)
{
    if (photoCount >= MAX_PHOTOS || depth > 5)
        return;

    SdFile dir;
    if (!dir.open(dirPath.c_str(), O_RDONLY) || !dir.isDir())
    {
        dir.close();
        return;
    }

    SdFile entry;
    while (photoCount < MAX_PHOTOS && entry.openNext(&dir, O_RDONLY))
    {
        char name[96];
        if (!entry.getName(name, sizeof(name)))
        {
            entry.close();
            continue;
        }

        String childPath = joinPath(dirPath.c_str(), String(name));
        bool isDirectory = entry.isDir();
        if (!isDirectory && hasSupportedExtension(String(name)))
            photoList[photoCount++] = childPath;
        entry.close();

        if (isDirectory)
            scanPhotosInDir(childPath, depth + 1);
    }
    dir.close();
}

uint16_t scanPhotos()
{
    photoCount = 0;
    scanPhotosInDir(photoRoot(), 0);
    return photoCount;
}

bool deleteManagedFile(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0 || !hasSupportedExtension(managed))
        return false;

    SdFile file;
    if (!file.open(managed.c_str(), O_RDONLY) || file.isDir())
    {
        file.close();
        return false;
    }
    file.close();
    return display.getSdFat().remove(managed.c_str());
}

bool createManagedFolder(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0)
        return false;
    return display.getSdFat().mkdir(managed.c_str(), true);
}

bool deleteFolderRecursive(const String &path, uint8_t depth)
{
    if (depth > 8)
        return false;

    SdFat &sd = display.getSdFat();
    SdFile folder;
    if (!folder.open(path.c_str(), O_RDONLY) || !folder.isDir())
    {
        folder.close();
        return false;
    }

    SdFile entry;
    while (entry.openNext(&folder, O_RDONLY))
    {
        char name[96];
        if (!entry.getName(name, sizeof(name)))
        {
            entry.close();
            folder.close();
            return false;
        }

        String childPath = joinPath(path.c_str(), String(name));
        bool isDirectory = entry.isDir();
        entry.close();

        if (isDirectory)
        {
            if (!deleteFolderRecursive(childPath, depth + 1))
            {
                folder.close();
                return false;
            }
        }
        else if (!sd.remove(childPath.c_str()))
        {
            folder.close();
            return false;
        }
    }

    folder.close();
    return sd.rmdir(path.c_str());
}

bool deleteManagedFolder(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0)
        return false;

    return deleteFolderRecursive(managed, 0);
}

void appendFileManagerRows(String &html, const String &dirPath, uint8_t depth, uint16_t &rows)
{
    if (rows >= 200 || depth > 5)
        return;

    SdFile dir;
    if (!dir.open(dirPath.c_str(), O_RDONLY) || !dir.isDir())
    {
        dir.close();
        return;
    }

    SdFile entry;
    while (rows < 200 && entry.openNext(&dir, O_RDONLY))
    {
        char name[96];
        if (!entry.getName(name, sizeof(name)))
        {
            entry.close();
            continue;
        }

        String childPath = joinPath(dirPath.c_str(), String(name));
        String indent;
        for (uint8_t i = 0; i < depth; ++i)
            indent += "&nbsp;&nbsp;&nbsp;";

        html += "<tr><td>";
        html += indent;
        html += entry.isDir() ? "Folder " : "File ";
        html += htmlEscape(name);
        html += "</td><td>";
        if (entry.isDir())
        {
            html += "-";
        }
        else
        {
            html += String(entry.fileSize());
            html += " bytes";
        }
        html += "</td><td>";
        if (entry.isDir())
        {
            html += "<form method='POST' action='/delete_folder' onsubmit=\"return confirm('Delete folder and contents?')\">";
            html += "<input type='hidden' name='path' value='" + htmlEscape(childPath) + "'>";
            html += "<button type='submit'>Delete folder</button></form>";
        }
        else if (hasSupportedExtension(String(name)))
        {
            html += "<form method='POST' action='/delete_file' onsubmit=\"return confirm('Delete file?')\">";
            html += "<input type='hidden' name='path' value='" + htmlEscape(childPath) + "'>";
            html += "<button type='submit'>Delete file</button></form>";
        }
        html += "</td></tr>";
        rows++;

        bool isDirectory = entry.isDir();
        entry.close();
        if (isDirectory)
            appendFileManagerRows(html, childPath, depth + 1, rows);
    }

    dir.close();
}

bool setDimensions(ImageDimensions &dimensions, uint32_t width, uint32_t height)
{
    if (width == 0 || height == 0 || width > 65535UL || height > 65535UL)
        return false;

    dimensions.width = (uint16_t)width;
    dimensions.height = (uint16_t)height;
    dimensions.valid = true;
    return true;
}

bool readPngDimensions(const char *path, ImageDimensions &dimensions)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t header[24];
    bool ok = file.read(header, sizeof(header)) == (int)sizeof(header);
    file.close();
    if (!ok)
        return false;

    static const uint8_t pngSignature[8] = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
    if (memcmp(header, pngSignature, sizeof(pngSignature)) != 0 || memcmp(header + 12, "IHDR", 4) != 0)
        return false;

    return setDimensions(dimensions, readBe32(header + 16), readBe32(header + 20));
}

bool readBmpDimensions(const char *path, ImageDimensions &dimensions)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t header[26];
    bool ok = file.read(header, sizeof(header)) == (int)sizeof(header);
    file.close();
    if (!ok || header[0] != 'B' || header[1] != 'M')
        return false;

    int32_t width = (int32_t)readLe32(header + 18);
    int32_t height = (int32_t)readLe32(header + 22);
    if (width <= 0 || height == 0)
        return false;
    if (height < 0)
        height = -height;

    return setDimensions(dimensions, (uint32_t)width, (uint32_t)height);
}

bool jpegMarkerHasDimensions(uint8_t marker)
{
    return marker == 0xC0 || marker == 0xC1 || marker == 0xC2 || marker == 0xC3 || marker == 0xC5 ||
           marker == 0xC6 || marker == 0xC7 || marker == 0xC9 || marker == 0xCA || marker == 0xCB ||
           marker == 0xCD || marker == 0xCE || marker == 0xCF;
}

bool readJpegDimensions(const char *path, ImageDimensions &dimensions)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t first;
    uint8_t second;
    if (!readByte(file, first) || !readByte(file, second) || first != 0xFF || second != 0xD8)
    {
        file.close();
        return false;
    }

    while (file.available())
    {
        uint8_t markerStart = 0;
        do
        {
            if (!readByte(file, markerStart))
            {
                file.close();
                return false;
            }
        } while (markerStart != 0xFF && file.available());

        uint8_t marker = 0;
        do
        {
            if (!readByte(file, marker))
            {
                file.close();
                return false;
            }
        } while (marker == 0xFF);

        if (marker == 0xD9 || marker == 0xDA)
            break;
        if (marker == 0x01 || (marker >= 0xD0 && marker <= 0xD7))
            continue;

        uint16_t segmentLength;
        if (!readBe16(file, segmentLength) || segmentLength < 2)
        {
            file.close();
            return false;
        }

        if (jpegMarkerHasDimensions(marker))
        {
            uint8_t precision;
            uint8_t sizeBytes[4];
            if (!readByte(file, precision) || file.read(sizeBytes, sizeof(sizeBytes)) != (int)sizeof(sizeBytes))
            {
                file.close();
                return false;
            }
            (void)precision;
            uint16_t height = readBe16(sizeBytes);
            uint16_t width = readBe16(sizeBytes + 2);
            file.close();
            return setDimensions(dimensions, width, height);
        }

        if (!file.seekCur((int32_t)segmentLength - 2))
        {
            file.close();
            return false;
        }
    }

    file.close();
    return false;
}

bool readBinDimensions(const char *path, ImageDimensions &dimensions)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t header[32];
    bool ok = file.read(header, sizeof(header)) == (int)sizeof(header);
    file.close();
    if (!ok)
        return false;

    uint32_t expectedBytes = (uint32_t)E_INK_WIDTH * (uint32_t)E_INK_HEIGHT / 2;
    if (memcmp(header, BIN_MAGIC, sizeof(BIN_MAGIC)) != 0 || header[8] != 1 ||
        readLe16(header + 16) != E_INK_WIDTH || readLe16(header + 18) != E_INK_HEIGHT ||
        readLe32(header + 20) != expectedBytes)
    {
        return false;
    }

    return setDimensions(dimensions, readLe16(header + 12), readLe16(header + 14));
}

bool readImageDimensions(const char *path, const String &lowerPath, ImageDimensions &dimensions)
{
    dimensions.width = 0;
    dimensions.height = 0;
    dimensions.valid = false;

    if (lowerPath.endsWith(".jpg") || lowerPath.endsWith(".jpeg"))
        return readJpegDimensions(path, dimensions);
    if (lowerPath.endsWith(".png"))
        return readPngDimensions(path, dimensions);
    if (lowerPath.endsWith(".bmp"))
        return readBmpDimensions(path, dimensions);
    if (lowerPath.endsWith(".bin"))
        return readBinDimensions(path, dimensions);
    return false;
}

uint8_t photoRotationForDimensions(const ImageDimensions &dimensions)
{
    if (dimensions.valid && dimensions.height > dimensions.width)
        return PHOTO_ROTATION_PORTRAIT;
    return PHOTO_ROTATION_LANDSCAPE;
}

uint16_t logicalWidthForRotation(uint8_t rotation)
{
    return (rotation == PHOTO_ROTATION_LANDSCAPE || rotation == 3) ? E_INK_HEIGHT : E_INK_WIDTH;
}

uint16_t logicalHeightForRotation(uint8_t rotation)
{
    return (rotation == PHOTO_ROTATION_LANDSCAPE || rotation == 3) ? E_INK_WIDTH : E_INK_HEIGHT;
}

int16_t centeredOffset(uint16_t contentSize, uint16_t screenSize)
{
    return contentSize < screenSize ? (int16_t)((screenSize - contentSize) / 2) : 0;
}

void configureHttpClient(HTTPClient &http)
{
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    http.setConnectTimeout(HTTP_CONNECT_TIMEOUT_MS);
    http.setTimeout(HTTP_READ_TIMEOUT_MS);
    http.setReuse(false);
    http.collectHeaders(HTTP_DEBUG_HEADER_KEYS, sizeof(HTTP_DEBUG_HEADER_KEYS) / sizeof(HTTP_DEBUG_HEADER_KEYS[0]));
}

String httpStatusText(HTTPClient &http, int code)
{
    if (code < 0)
        return String(code) + " (" + http.errorToString(code) + ")";
    return String(code);
}

void addHttpHeaders(HTTPClient &http, const char *accept)
{
    http.addHeader("Accept", accept);
    http.addHeader("Accept-Encoding", "identity");
}

String compactPreview(String value, size_t maxLength)
{
    value.replace('\r', ' ');
    value.replace('\n', ' ');
    value.trim();
    if (value.length() > maxLength)
        value = value.substring(0, maxLength) + "...";
    return value;
}

void serviceWebServerDuringLongTask()
{
    if (!configModeRunning)
        return;
    if (millis() - lastLongTaskWebService < 25)
        return;

    server.handleClient();
    lastLongTaskWebService = millis();
}

bool drawBinFromSd(const char *path)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t header[32];
    if (file.read(header, sizeof(header)) != (int)sizeof(header))
    {
        file.close();
        return false;
    }

    const uint32_t expectedBytes = (uint32_t)E_INK_WIDTH * (uint32_t)E_INK_HEIGHT / 2;
    bool ok = memcmp(header, BIN_MAGIC, sizeof(BIN_MAGIC)) == 0 && header[8] == 1 && readLe16(header + 16) == E_INK_WIDTH &&
              readLe16(header + 18) == E_INK_HEIGHT && readLe32(header + 20) == expectedBytes;

    if (!ok)
    {
        file.close();
        return false;
    }

    uint32_t copied = 0;
    uint8_t chunk[2048];
    while (copied < expectedBytes)
    {
        size_t toRead = expectedBytes - copied;
        if (toRead > sizeof(chunk))
            toRead = sizeof(chunk);
        int got = file.read(chunk, toRead);
        if (got <= 0)
        {
            file.close();
            return false;
        }
        memcpy(display.DMemory4Bit + copied, chunk, got);
        copied += got;
    }

    file.close();
    return true;
}

bool drawCommonImageFromSd(const char *path, const ImageDimensions &dimensions, uint8_t rotation)
{
    String lower(path);
    lower.toLowerCase();
    int16_t x = 0;
    int16_t y = 0;
    if (dimensions.valid)
    {
        x = centeredOffset(dimensions.width, logicalWidthForRotation(rotation));
        y = centeredOffset(dimensions.height, logicalHeightForRotation(rotation));
    }

    if (lower.endsWith(".jpg") || lower.endsWith(".jpeg"))
        return display.image.draw(path, ImageColor::JPG, x, y, true, false);
    if (lower.endsWith(".png"))
        return display.image.draw(path, ImageColor::PNG, x, y, true, false);
    if (lower.endsWith(".bmp"))
        return display.image.draw(path, ImageColor::BMP, x, y, true, false);
    return false;
}

bool displayPhoto(const String &path)
{
    Serial.print("Displaying ");
    Serial.println(path);

    bool ok = false;
    String lower(path);
    lower.toLowerCase();
    ImageDimensions dimensions;
    readImageDimensions(path.c_str(), lower, dimensions);
    uint8_t rotation = photoRotationForDimensions(dimensions);
    display.setRotation(rotation);

    display.clearDisplay();
    if (lower.endsWith(".bin"))
        ok = drawBinFromSd(path.c_str());
    else
        ok = drawCommonImageFromSd(path.c_str(), dimensions, rotation);

    if (ok)
        display.display();
    setUiRotation();
    return ok;
}

bool downloadFile(const String &url, const String &path)
{
    debugLog("Download direct start: " + path + " from " + redactUrlToken(url));
    HTTPClient http;
    configureHttpClient(http);
    if (!http.begin(url))
    {
        debugLog("Download direct begin failed");
        return false;
    }

    addHttpHeaders(http, "*/*");
    int code = http.GET();
    debugLog("Download direct HTTP " + httpStatusText(http, code) + ", type=" + http.header("Content-Type") +
             ", transfer=" + http.header("Transfer-Encoding") + ", size=" + String(http.getSize()));
    if (code != HTTP_CODE_OK)
    {
        Serial.printf("Download HTTP %s: %s\n", httpStatusText(http, code).c_str(), url.c_str());
        http.end();
        return false;
    }

    String tmpPath = path + ".tmp";
    SdFat &sd = display.getSdFat();
    sd.remove(tmpPath.c_str());

    SdFile out;
    if (!out.open(tmpPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC))
    {
        debugLog("Download direct SD open failed: " + tmpPath);
        http.end();
        return false;
    }

    WiFiClient *stream = http.getStreamPtr();
    int32_t remaining = http.getSize();
    uint8_t buffer[2048];
    uint32_t lastData = millis();
    bool ok = true;

    while ((http.connected() || stream->available()) && (remaining > 0 || remaining == -1))
    {
        size_t available = stream->available();
        if (available)
        {
            size_t toRead = available > sizeof(buffer) ? sizeof(buffer) : available;
            int got = stream->readBytes(buffer, toRead);
            if (got > 0)
            {
                out.write(buffer, got);
                if (remaining > 0)
                    remaining -= got;
                lastData = millis();
                serviceWebServerDuringLongTask();
            }
        }
        else
        {
            if (millis() - lastData > DOWNLOAD_IDLE_TIMEOUT_MS)
            {
                debugLog("Download direct idle timeout: " + path);
                ok = false;
                break;
            }
            serviceWebServerDuringLongTask();
            delay(2);
        }
    }

    out.close();
    http.end();

    if (!ok || remaining > 0)
    {
        debugLog("Download direct failed: " + path + ", remaining=" + String(remaining));
        sd.remove(tmpPath.c_str());
        return false;
    }

    sd.remove(path.c_str());
    bool renamed = sd.rename(tmpPath.c_str(), path.c_str());
    debugLog(String("Download direct ") + (renamed ? "saved: " : "rename failed: ") + path);
    return renamed;
}

int8_t base64Value(char c)
{
    if (c >= 'A' && c <= 'Z')
        return c - 'A';
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 26;
    if (c >= '0' && c <= '9')
        return c - '0' + 52;
    if (c == '+')
        return 62;
    if (c == '/')
        return 63;
    if (c == '=')
        return 64;
    if (c == '\r' || c == '\n' || c == ' ' || c == '\t')
        return -2;
    return -1;
}

bool writeBase64Char(SdFile &out, char c, uint8_t quartet[4], uint8_t &quartetLen, uint32_t &decodedBytes)
{
    int8_t value = base64Value(c);
    if (value == -2)
        return true;
    if (value < 0)
        return false;

    quartet[quartetLen++] = value;
    if (quartetLen < 4)
        return true;

    if (quartet[0] == 64 || quartet[1] == 64 || (quartet[2] == 64 && quartet[3] != 64))
    {
        quartetLen = 0;
        return false;
    }

    uint8_t decoded[3];
    decoded[0] = (quartet[0] << 2) | (quartet[1] >> 4);
    decoded[1] = ((quartet[1] & 0x0F) << 4) | (quartet[2] >> 2);
    decoded[2] = ((quartet[2] & 0x03) << 6) | quartet[3];

    uint8_t count = 3;
    if (quartet[2] == 64)
        count = 1;
    else if (quartet[3] == 64)
        count = 2;

    if (out.write(decoded, count) != count)
    {
        quartetLen = 0;
        return false;
    }
    decodedBytes += count;
    quartetLen = 0;
    return true;
}

class Base64SdDecodeStream : public Stream
{
  public:
    explicit Base64SdDecodeStream(SdFile &outFile) : out(outFile)
    {
    }

    size_t write(uint8_t value) override
    {
        return write(&value, 1);
    }

    size_t write(const uint8_t *buffer, size_t size) override
    {
        if (failed)
        {
            setWriteError();
            return 0;
        }

        for (size_t i = 0; i < size; ++i)
        {
            if (responsePreview.length() < 96)
            {
                char previewChar = (char)buffer[i];
                responsePreview += (previewChar >= 32 && previewChar <= 126) ? previewChar : '.';
            }
            if (base64Value((char)buffer[i]) >= 0)
                base64Chars++;

            if (!writeBase64Char(out, (char)buffer[i], quartet, quartetLen, decodedBytes))
            {
                inputBytes += i;
                failed = true;
                errorMessage = "Download Apps Script base64/write failed at body byte " + String(inputBytes) +
                               ", char=" + String(buffer[i]) + ", preview=" + compactPreview(responsePreview, 96);
                setWriteError();
                return i;
            }
        }

        inputBytes += size;
        serviceWebServerDuringLongTask();
        return size;
    }

    int available() override
    {
        return 0;
    }

    int read() override
    {
        return -1;
    }

    int peek() override
    {
        return -1;
    }

    void flush() override
    {
        out.sync();
    }

    bool finish(uint32_t expectedSize)
    {
        if (quartetLen == 0)
            return !failed;

        String stats = statsString(expectedSize);
        if (expectedSize > 0 && decodedBytes == expectedSize)
        {
            debugLog("Download Apps Script ignored trailing incomplete base64 quartet" + stats);
            quartetLen = 0;
            return !failed;
        }

        errorMessage = "Download Apps Script base64 ended mid-quartet" + stats;
        if (expectedSize > 0 && decodedBytes < expectedSize)
            errorMessage += ". Response is shorter than the Drive file; check the Apps Script token/deployment.";
        failed = true;
        setWriteError();
        return false;
    }

    String statsString(uint32_t expectedSize) const
    {
        return ", inputBytes=" + String(inputBytes) + ", base64Chars=" + String(base64Chars) +
               ", quartetLen=" + String(quartetLen) + ", decodedBytes=" + String(decodedBytes) +
               ", expected=" + String(expectedSize) + ", preview=" + compactPreview(responsePreview, 96);
    }

    uint32_t inputSize() const
    {
        return inputBytes;
    }

    uint32_t base64CharCount() const
    {
        return base64Chars;
    }

    uint32_t decodedSize() const
    {
        return decodedBytes;
    }

    const String &error() const
    {
        return errorMessage;
    }

  private:
    SdFile &out;
    uint8_t quartet[4] = {0};
    uint8_t quartetLen = 0;
    uint32_t inputBytes = 0;
    uint32_t base64Chars = 0;
    uint32_t decodedBytes = 0;
    String responsePreview;
    String errorMessage;
    bool failed = false;
};

bool downloadBase64File(const String &url, const String &path, uint32_t expectedSize, uint32_t &decodedSize)
{
    decodedSize = 0;
    lastDownloadError = "";
    debugLog("Download Apps Script start: " + path + ", expected=" + String(expectedSize) + " from " +
             redactUrlToken(url));
    HTTPClient http;
    configureHttpClient(http);
    if (!http.begin(url))
    {
        setDownloadError("Download Apps Script begin failed");
        return false;
    }

    addHttpHeaders(http, "text/plain");
    int code = http.GET();
    String contentType = http.header("Content-Type");
    String transferEncoding = http.header("Transfer-Encoding");
    debugLog("Download Apps Script HTTP " + httpStatusText(http, code) + ", type=" + contentType +
             ", transfer=" + transferEncoding + ", size=" + String(http.getSize()));
    if (code != HTTP_CODE_OK)
    {
        setDownloadError("Download Apps Script HTTP failed: " + httpStatusText(http, code));
        Serial.printf("Base64 download HTTP %s\n", httpStatusText(http, code).c_str());
        http.end();
        return false;
    }

    String lowerContentType = contentType;
    lowerContentType.toLowerCase();
    if (lowerContentType.indexOf("json") >= 0 || lowerContentType.indexOf("html") >= 0)
    {
        String response = http.getString();
        setDownloadError("Download Apps Script returned non-base64 response: " + compactPreview(response, 220));
        http.end();
        return false;
    }

    String tmpPath = path + ".tmp";
    SdFat &sd = display.getSdFat();
    sd.remove(tmpPath.c_str());

    SdFile out;
    if (!out.open(tmpPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC))
    {
        setDownloadError("Download Apps Script SD open failed: " + tmpPath);
        http.end();
        return false;
    }

    Base64SdDecodeStream decoder(out);
    int bodyBytes = http.writeToStream(&decoder);
    bool ok = decoder.finish(expectedSize);

    out.close();
    http.end();
    uint32_t decodedBytes = decoder.decodedSize();
    decodedSize = decodedBytes;
    debugLog("Download Apps Script stream done: bodyBytes=" + String(bodyBytes) +
             ", inputBytes=" + String(decoder.inputSize()) + ", base64Chars=" + String(decoder.base64CharCount()) +
             ", decodedBytes=" + String(decodedBytes));

    if (bodyBytes < 0)
    {
        if (decoder.error().length())
            setDownloadError(decoder.error() + ", path=" + path);
        else
            setDownloadError("Download Apps Script stream failed: " + httpStatusText(http, bodyBytes) +
                             ", path=" + path);
        ok = false;
    }
    else if (!ok && decoder.error().length())
    {
        setDownloadError(decoder.error() + ", path=" + path);
    }

    if (!ok)
    {
        if (lastDownloadError.length() == 0)
            setDownloadError("Download Apps Script failed: " + path);
        sd.remove(tmpPath.c_str());
        return false;
    }
    if (expectedSize > 0 && decodedBytes != expectedSize)
    {
        debugLog("Download Apps Script decoded size differs from Drive metadata: expected=" + String(expectedSize) +
                 ", decoded=" + String(decodedBytes) + ". Keeping decoded file.");
    }

    sd.remove(path.c_str());
    bool renamed = sd.rename(tmpPath.c_str(), path.c_str());
    if (!renamed)
    {
        uint32_t tmpSize = 0;
        SdFile tmpInfo;
        if (tmpInfo.open(tmpPath.c_str(), O_RDONLY))
        {
            tmpSize = tmpInfo.fileSize();
            tmpInfo.close();
        }
        debugLog("Download Apps Script rename failed, trying copy fallback: " + tmpPath + " -> " + path +
                 ", tmpSize=" + String(tmpSize));
        uint32_t copiedBytes = 0;
        bool copied = copySdFile(tmpPath, path, copiedBytes);
        if (copied && copiedBytes == decodedBytes)
        {
            sd.remove(tmpPath.c_str());
            debugLog("Download Apps Script saved with copy fallback: " + path + ", copied=" + String(copiedBytes));
            return true;
        }

        sd.remove(path.c_str());
        setDownloadError("Download Apps Script rename/copy failed: " + tmpPath + " -> " + path +
                         ", tmpSize=" + String(tmpSize) + ", copied=" + String(copiedBytes) +
                         ", decoded=" + String(decodedBytes));
    }
    else
    {
        debugLog("Download Apps Script saved: " + path);
    }
    return renamed;
}

void loadSyncState(DynamicJsonDocument &stateDoc)
{
    SdFile file;
    if (file.open(SYNC_STATE_PATH, O_RDONLY))
    {
        DeserializationError err = deserializeJson(stateDoc, file);
        file.close();
        if (!err && stateDoc["photos"].is<JsonArray>())
            return;
    }

    stateDoc.clear();
    stateDoc.createNestedArray("photos");
}

bool saveSyncState(DynamicJsonDocument &stateDoc)
{
    SdFat &sd = display.getSdFat();
    sd.remove(SYNC_STATE_PATH);
    SdFile file;
    if (!file.open(SYNC_STATE_PATH, O_WRONLY | O_CREAT | O_TRUNC))
        return false;
    serializeJsonPretty(stateDoc, file);
    file.close();
    return true;
}

JsonObject findStateEntry(JsonArray statePhotos, const String &id)
{
    for (JsonVariant value : statePhotos)
    {
        JsonObject entry = value.as<JsonObject>();
        if (String(entry["id"] | "") == id)
            return entry;
    }
    return JsonObject();
}

bool localFileSize(const String &path, uint32_t &actualSize)
{
    SdFile file;
    if (!file.open(path.c_str(), O_RDONLY))
        return false;
    actualSize = file.fileSize();
    file.close();
    return true;
}

bool localFileMatches(const String &path, uint32_t expectedSize)
{
    uint32_t actualSize = 0;
    if (!localFileSize(path, actualSize))
        return false;
    return actualSize == expectedSize;
}

bool stateMatches(JsonObject state, const String &name, const String &modified, uint32_t size)
{
    if (state.isNull())
        return false;
    return String(state["name"] | "") == name && String(state["modified"] | "") == modified &&
           ((uint32_t)(state["size"] | 0)) == size;
}

uint32_t stateLocalSize(JsonObject state, uint32_t fallbackSize)
{
    if (state.isNull())
        return fallbackSize;
    uint32_t localSize = state["local_size"] | 0;
    return localSize > 0 ? localSize : fallbackSize;
}

void recordSyncState(JsonArray statePhotos, const String &id, const String &name, const String &modified, uint32_t size,
                     uint32_t localSize)
{
    JsonObject item = statePhotos.createNestedObject();
    item["id"] = id;
    item["name"] = name;
    item["modified"] = modified;
    item["size"] = size;
    item["local_size"] = localSize;
}

String filenameFromUrl(const String &url, uint16_t index)
{
    return sanitizeFilename(url, index);
}

uint16_t syncFromDriveFolder()
{
    debugLog(String("Sync start build=") + FRAME_BUILD_ID);
    lastDownloadError = "";
    if (strlen(config.scriptUrl) == 0)
    {
        lastWebMessage = "No Apps Script URL configured.";
        debugLog(lastWebMessage);
        return 0;
    }
    if (strlen(config.syncToken) == 0)
    {
        lastWebMessage = "No sync token configured.";
        debugLog(lastWebMessage);
        return 0;
    }
    if (!connectWiFi(WIFI_TIMEOUT_MS))
    {
        lastWebMessage = "WiFi connection failed.";
        debugLog(lastWebMessage);
        return 0;
    }
    debugLog("WiFi connected: ip=" + WiFi.localIP().toString() + ", rssi=" + String(WiFi.RSSI()) +
             ", ssid=" + String(config.wifiSsid));

    HTTPClient http;
    configureHttpClient(http);
    String requestUrl = buildScriptUrl("manifest");
    debugLog("Manifest URL: " + redactUrlToken(requestUrl));
    if (!http.begin(requestUrl))
    {
        lastWebMessage = "Could not open Apps Script URL.";
        debugLog(lastWebMessage);
        return 0;
    }

    addHttpHeaders(http, "application/json");
    int code = http.GET();
    debugLog("Manifest HTTP " + httpStatusText(http, code) + ", type=" + http.header("Content-Type") +
             ", transfer=" + http.header("Transfer-Encoding") + ", contentLength=" + http.header("Content-Length") +
             ", getSize=" + String(http.getSize()));
    if (code != HTTP_CODE_OK)
    {
        lastWebMessage = "Manifest HTTP error " + httpStatusText(http, code);
        debugLog(lastWebMessage + ", location=" + http.header("Location"));
        http.end();
        return 0;
    }

    String manifestBody = http.getString();
    http.end();
    writeTextFile(MANIFEST_RESPONSE_PATH, manifestBody);
    debugLog("Manifest body bytes=" + String(manifestBody.length()));
    debugLog("Manifest body preview: " + compactPreview(manifestBody, 220));
    if (manifestBody.length() > MAX_MANIFEST_BODY_BYTES)
    {
        lastWebMessage = "Manifest too large: " + String(manifestBody.length()) + " bytes. Limit Drive folder to " +
                         String((uint16_t)MAX_MANIFEST_ITEMS) + " files.";
        debugLog(lastWebMessage);
        return 0;
    }

    DynamicJsonDocument doc(MANIFEST_JSON_CAPACITY);
    DeserializationError err = deserializeJson(doc, manifestBody);
    if (err)
    {
        lastWebMessage = String("Manifest JSON ") + err.c_str() + ": " + compactPreview(manifestBody, 96);
        debugLog(lastWebMessage);
        return 0;
    }
    debugLog("Manifest JSON parsed successfully");

    JsonArray photos;
    if (doc.is<JsonArray>())
        photos = doc.as<JsonArray>();
    else
        photos = doc["photos"].as<JsonArray>();

    if (photos.isNull())
    {
        lastWebMessage = "Manifest must be an array or contain photos[].";
        debugLog(lastWebMessage);
        return 0;
    }
    debugLog("Manifest photos count=" + String((uint32_t)photos.size()));

    ensureStorage();
    DynamicJsonDocument stateDoc(32768);
    DynamicJsonDocument newStateDoc(32768);
    loadSyncState(stateDoc);
    JsonArray oldState = stateDoc["photos"].as<JsonArray>();
    JsonArray newState = newStateDoc.createNestedArray("photos");

    uint16_t downloaded = 0;
    uint16_t skipped = 0;
    uint16_t failed = 0;
    uint16_t seen = 0;

    for (JsonVariant item : photos)
    {
        serviceWebServerDuringLongTask();
        if (seen >= MAX_MANIFEST_ITEMS)
        {
            debugLog("Manifest item cap reached: " + String((uint16_t)MAX_MANIFEST_ITEMS));
            break;
        }
        seen++;

        if (!item.is<JsonObject>())
        {
            debugLog("Manifest item " + String(seen) + " ignored: not an object");
            continue;
        }

        String id = item["id"] | "";
        String url;
        String name = item["name"] | "";
        String modified = item["modified"] | "";
        uint32_t remoteSize = item["size"] | 0;

        if (name.length() == 0)
            name = id.length() ? ("drive_" + id + ".jpg") : filenameFromUrl(url, seen);
        name = sanitizeFilename(name, seen);
        if (!hasSupportedExtension(name))
        {
            debugLog("Manifest item " + String(seen) + " ignored: unsupported name " + name);
            continue;
        }

        debugLog("Manifest item " + String(seen) + ": name=" + name + ", idLen=" + String(id.length()) +
                 ", size=" + String(remoteSize) + ", modified=" + modified);

        String target = joinPath(config.photoDir, name);
        JsonObject oldEntry = findStateEntry(oldState, id);
        uint32_t expectedLocalSize = stateLocalSize(oldEntry, remoteSize);
        bool unchanged = id.length() > 0 && expectedLocalSize > 0 && localFileMatches(target, expectedLocalSize) &&
                         stateMatches(oldEntry, name, modified, remoteSize);

        if (unchanged)
        {
            skipped++;
            debugLog("Skipped unchanged: " + target);
            recordSyncState(newState, id, name, modified, remoteSize, expectedLocalSize);
            continue;
        }

        bool ok = false;
        bool usedAppsScriptDownload = false;
        uint32_t savedSize = 0;
        url = item["url"] | "";
        if (url.length())
        {
            ok = downloadFile(url, target);
            if (ok)
                localFileSize(target, savedSize);
        }
        else if (id.length())
        {
            usedAppsScriptDownload = true;
            ok = downloadBase64File(buildScriptUrl("file", id), target, remoteSize, savedSize);
        }
        else
        {
            setDownloadError("Manifest item has no download URL or Drive id: " + name);
        }

        if (ok && remoteSize > 0 && !usedAppsScriptDownload && savedSize != remoteSize)
        {
            display.getSdFat().remove(target.c_str());
            setDownloadError("Downloaded size mismatch, removed: " + target + ", expected=" + String(remoteSize) +
                             ", actual=" + String(savedSize));
            ok = false;
        }

        if (ok)
        {
            if (savedSize == 0)
                localFileSize(target, savedSize);
            downloaded++;
            debugLog("Downloaded OK: " + target + ", localSize=" + String(savedSize) +
                     ", driveSize=" + String(remoteSize));
            recordSyncState(newState, id, name, modified, remoteSize, savedSize);
        }
        else
        {
            failed++;
            debugLog("Download failed: " + target +
                     (lastDownloadError.length() ? ", reason=" + lastDownloadError : ""));
        }
    }

    saveSyncState(newStateDoc);
    if (!configModeRunning)
        WiFi.mode(WIFI_OFF);
    lastWebMessage = "Downloaded " + String(downloaded) + ", skipped " + String(skipped) + ", failed " +
                     String(failed) + " of " + String(seen) + " Drive items.";
    if (failed > 0 && lastDownloadError.length())
        lastWebMessage += " Last error: " + lastDownloadError;
    debugLog("Sync done: " + lastWebMessage);
    return downloaded;
}

void sleepForMinutes(uint32_t minutes)
{
    if (minutes == 0)
        minutes = 1;
    display.sdCardSleep();
    WiFi.mode(WIFI_OFF);
    esp_sleep_enable_timer_wakeup((uint64_t)minutes * 60ULL * 1000000ULL);
    esp_sleep_enable_ext0_wakeup(WAKE_BUTTON_PIN, WAKE_BUTTON_ACTIVE_LEVEL);
    esp_deep_sleep_start();
}

void handleLowBattery(float voltage)
{
    showStatus("Battery low", "Please charge the Inkplate.", "Battery: " + String(voltage, 2) + " V");
    sleepForMinutes(360);
}

void runFrameMode()
{
    float voltage = display.readBattery();
    if (voltage > 1.0f && voltage < config.lowBatteryVoltage)
        handleLowBattery(voltage);

    if (!syncCounterInitialized)
    {
        updatesSinceLastSync = config.syncEveryUpdates;
        syncCounterInitialized = true;
    }
    else if (updatesSinceLastSync < UINT32_MAX)
    {
        updatesSinceLastSync++;
    }

    scanPhotos();
    bool syncConfigured = strlen(config.scriptUrl) > 0 && strlen(config.syncToken) > 0 && strlen(config.wifiSsid) > 0;
    bool shouldSync = syncConfigured && (photoCount == 0 || updatesSinceLastSync >= config.syncEveryUpdates);
    bool didSync = false;
    if (photoCount == 0 && shouldSync)
    {
        showStatus("No local photos", "Syncing from Drive...");
        syncInProgress = true;
        syncFromDriveFolder();
        syncInProgress = false;
        updatesSinceLastSync = 0;
        didSync = true;
        scanPhotos();
    }

    if (photoCount == 0)
    {
        showStatus("No photos found", String("Copy JPG, PNG, BMP, or BIN files to ") + config.photoDir,
                   "Or use USB/config mode to sync.");
        sleepForMinutes(config.updateMinutes);
    }

    randomSeed(micros());
    uint16_t start = config.shuffle ? random(photoCount) : (config.lastIndex % photoCount);
    bool shown = false;

    for (uint16_t attempt = 0; attempt < photoCount && !shown; ++attempt)
    {
        uint16_t index = (start + attempt) % photoCount;
        shown = displayPhoto(photoList[index]);
        if (shown && !config.shuffle)
        {
            config.lastIndex = (index + 1) % photoCount;
            saveConfig();
        }
    }

    if (!shown)
        showStatus("Image error", "No supported photos could be displayed.", config.photoDir);

    if (shown && shouldSync && !didSync)
    {
        syncInProgress = true;
        syncFromDriveFolder();
        syncInProgress = false;
        updatesSinceLastSync = 0;
    }

    sleepForMinutes(config.updateMinutes);
}

