void redirectHome()
{
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

bool rejectIfSyncInProgress()
{
    if (!syncInProgress)
        return false;

    server.send(409, "text/plain", "Sync is in progress. Open /log for progress and try this command again later.");
    return true;
}

void handleTextFile(const char *path, const char *missingMessage)
{
    String body = readTextFileTail(path, MAX_DEBUG_LOG_BYTES);
    if (body.length() == 0)
        body = missingMessage;
    server.send(200, "text/plain", body);
}

void handleDebugLog()
{
    handleTextFile(DEBUG_LOG_PATH, "No debug log yet.\n");
}

void handleManifestResponse()
{
    handleTextFile(MANIFEST_RESPONSE_PATH, "No manifest response captured yet.\n");
}

void handleClearLog()
{
    if (rejectIfSyncInProgress())
        return;

    SdFat &sd = display.getSdFat();
    sd.remove(DEBUG_LOG_PATH);
    sd.remove(MANIFEST_RESPONSE_PATH);
    lastWebMessage = "Debug log cleared.";
    redirectHome();
}

void handleSave()
{
    if (rejectIfSyncInProgress())
        return;

    copyString(config.wifiSsid, server.arg("ssid").c_str(), sizeof(config.wifiSsid));
    if (server.arg("password").length() > 0)
        copyString(config.wifiPassword, server.arg("password").c_str(), sizeof(config.wifiPassword));
    copyString(config.scriptUrl, server.arg("script_url").c_str(), sizeof(config.scriptUrl));
    if (server.arg("sync_token").length() > 0)
        copyString(config.syncToken, server.arg("sync_token").c_str(), sizeof(config.syncToken));
    uint32_t syncEvery = max(1UL, (unsigned long)server.arg("sync_every").toInt());
    if (syncEvery > 65535UL)
        syncEvery = 65535UL;
    config.syncEveryUpdates = (uint16_t)syncEvery;
    copyString(config.photoDir, server.arg("photo_dir").c_str(), sizeof(config.photoDir));
    normalizePhotoDir();
    config.shuffle = server.hasArg("shuffle");
    config.updateMinutes = max(1UL, (unsigned long)server.arg("interval").toInt());
    config.lowBatteryVoltage = server.arg("low_battery").toFloat();
    if (config.lowBatteryVoltage < 3.0f || config.lowBatteryVoltage > 4.2f)
        config.lowBatteryVoltage = 3.45f;
    saveConfig();
    updatesSinceLastSync = config.syncEveryUpdates;
    syncCounterInitialized = true;
    display.getSdFat().remove(CONFIG_TRIGGER_PATH);
    configReconnectPending = true;
    configReconnectAt = millis() + 1500;
    lastWebMessage = "Settings saved. Reconnecting WiFi...";
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

void handleSync()
{
    if (syncInProgress || configSyncPending)
    {
        lastWebMessage = "Sync is already running.";
        redirectHome();
        return;
    }

    configSyncPending = true;
    lastWebMessage = "Sync queued. Open /log for progress.";
    redirectHome();
}

void handleShow()
{
    if (rejectIfSyncInProgress())
        return;

    scanPhotos();
    if (photoCount == 0)
        lastWebMessage = "No local photos to show.";
    else
    {
        uint16_t index = config.lastIndex % photoCount;
        lastWebMessage = displayPhoto(photoList[index]) ? "Displayed " + photoList[index] : "Display failed.";
        config.lastIndex = (index + 1) % photoCount;
        saveConfig();
    }
    server.sendHeader("Location", "/");
    server.send(303, "text/plain", "");
}

void handleCreateFolder()
{
    if (rejectIfSyncInProgress())
        return;

    String requestedPath = server.arg("path");
    if (createManagedFolder(requestedPath))
        lastWebMessage = "Folder created.";
    else
        lastWebMessage = "Folder create failed.";
    redirectHome();
}

void handleDeleteFile()
{
    if (rejectIfSyncInProgress())
        return;

    String requestedPath = server.arg("path");
    if (deleteManagedFile(requestedPath))
        lastWebMessage = "File deleted.";
    else
        lastWebMessage = "File delete failed.";
    scanPhotos();
    redirectHome();
}

void handleDeleteFolder()
{
    if (rejectIfSyncInProgress())
        return;

    String requestedPath = server.arg("path");
    if (deleteManagedFolder(requestedPath))
        lastWebMessage = "Folder deleted.";
