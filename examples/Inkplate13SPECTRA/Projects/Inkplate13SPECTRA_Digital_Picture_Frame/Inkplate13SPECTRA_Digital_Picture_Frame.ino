void handleUploadComplete()
{
    if (rejectIfSyncInProgress())
        return;

    if (uploadResultMessage.length() == 0)
        uploadResultMessage = "No upload received.";
    lastWebMessage = uploadResultMessage;
    scanPhotos();
    redirectHome();
}

void handleUpload()
{
    if (syncInProgress)
        return;

    HTTPUpload &upload = server.upload();
    SdFat &sd = display.getSdFat();

    if (upload.status == UPLOAD_FILE_START)
    {
        uploadOk = false;
        uploadFinalPath = "";
        uploadTempPath = "";
        uploadResultMessage = "";

        String folder = normalizeManagedPath(server.arg("folder"), true);
        String filename = sanitizeUploadFilename(upload.filename);
        if (folder.length() == 0 || filename.length() == 0)
        {
            uploadResultMessage = "Upload rejected: unsupported file name.";
            return;
        }

        sd.mkdir(folder.c_str(), true);
        uploadFinalPath = joinPath(folder.c_str(), filename);
        uploadTempPath = uploadFinalPath + ".upload";
        sd.remove(uploadTempPath.c_str());

        uploadOk = uploadFile.open(uploadTempPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC);
        if (!uploadOk)
            uploadResultMessage = "Upload failed: could not open file.";
    }
    else if (upload.status == UPLOAD_FILE_WRITE)
    {
        if (!uploadOk)
            return;

        size_t written = uploadFile.write(upload.buf, upload.currentSize);
        if (written != upload.currentSize)
        {
            uploadOk = false;
            uploadResultMessage = "Upload failed: SD write error.";
        }
    }
    else if (upload.status == UPLOAD_FILE_END)
    {
        if (uploadTempPath.length())
            uploadFile.close();
        if (uploadOk)
        {
            sd.remove(uploadFinalPath.c_str());
            if (sd.rename(uploadTempPath.c_str(), uploadFinalPath.c_str()))
                uploadResultMessage = "Uploaded " + uploadFinalPath;
            else
            {
                sd.remove(uploadTempPath.c_str());
                uploadResultMessage = "Upload failed: rename error.";
            }
        }
        else if (uploadTempPath.length())
        {
            sd.remove(uploadTempPath.c_str());
        }
    }
    else if (upload.status == UPLOAD_FILE_ABORTED)
    {
        if (uploadTempPath.length())
            uploadFile.close();
        if (uploadTempPath.length())
            sd.remove(uploadTempPath.c_str());
        uploadOk = false;
        uploadResultMessage = "Upload aborted.";
    }
}

void handleReboot()
{
    if (rejectIfSyncInProgress())
        return;

    display.getSdFat().remove(CONFIG_TRIGGER_PATH);
    server.send(200, "text/plain", "Rebooting...");
    delay(500);
    ESP.restart();
}

void runConfigMode()
{
    configModeRunning = true;
    bool wifiConnected = refreshConfigNetwork(12000);
    if (lastWebMessage.length() == 0)
    {
        lastWebMessage = wifiConnected ? "Serving config on home WiFi. Config AP disabled." :
                                         "Serving config on fallback AP.";
    }
    showConfigStatus();

    server.on("/", HTTP_GET, handleIndex);
    server.on("/log", HTTP_GET, handleDebugLog);
    server.on("/manifest_response", HTTP_GET, handleManifestResponse);
    server.on("/clear_log", HTTP_POST, handleClearLog);
    server.on("/save", HTTP_POST, handleSave);
    server.on("/sync", HTTP_POST, handleSync);
    server.on("/show", HTTP_POST, handleShow);
    server.on("/upload", HTTP_POST, handleUploadComplete, handleUpload);
    server.on("/mkdir", HTTP_POST, handleCreateFolder);
    server.on("/delete_file", HTTP_POST, handleDeleteFile);
    server.on("/delete_folder", HTTP_POST, handleDeleteFolder);
    server.on("/reboot", HTTP_POST, handleReboot);
    server.begin();

    bool lastRawButton = wakeButtonPressed();
    bool stableButton = lastRawButton;
    uint32_t lastButtonChange = millis();

    while (true)
    {
        server.handleClient();

        if (configSyncPending && !syncInProgress)
        {
            configSyncPending = false;
            syncInProgress = true;
            lastWebMessage = "Sync in progress. Open /log for details.";
            uint16_t count = syncFromDriveFolder();
            scanPhotos();
            syncInProgress = false;
            if (WiFi.status() != WL_CONNECTED && !configApRunning)
                startConfigAp();
            lastWebMessage += " Total local photos: " + String(photoCount) + ".";
            Serial.printf("Synced %u photos\n", count);
        }

        if (configReconnectPending && millis() - configReconnectAt < 0x80000000UL)
        {
            configReconnectPending = false;
            bool wifiConnected = refreshConfigNetwork(12000);
            lastWebMessage = wifiConnected ? String("Settings saved. WiFi connected at http://") +
                                                  WiFi.localIP().toString() + ". Config AP disabled." :
                                              "Settings saved. WiFi not connected. Config AP enabled.";
            showConfigStatus();
        }

        bool rawButton = wakeButtonPressed();
        if (rawButton != lastRawButton)
        {
            lastRawButton = rawButton;
            lastButtonChange = millis();
        }

        if (rawButton != stableButton && millis() - lastButtonChange >= WAKE_BUTTON_DEBOUNCE_MS)
        {
            stableButton = rawButton;
            if (stableButton)
            {
                display.getSdFat().remove(CONFIG_TRIGGER_PATH);
                lastWebMessage = "Config mode closed with WAKE button.";
                showStatus("Photo mode", "Web config closed.", "Returning to frame mode...");
                WiFi.softAPdisconnect(true);
                configApRunning = false;
                WiFi.disconnect(true);
                WiFi.mode(WIFI_OFF);
                configModeRunning = false;
                return;
            }
        }

        delay(10);
    }
}

void setup()
{
    Serial.begin(115200);
    display.begin();
    display.setTextColor(INKPLATE_BLACK);
    display.setTextSize(2);

    if (!display.sdCardInit())
    {
        showStatus("SD card error", "Insert a FAT-formatted SD card.");
        while (true)
            delay(1000);
    }

    bool hadConfig = loadConfig();
    ensureStorage();
    if (!hadConfig)
        saveConfig();

    bool forceConfig = display.getSdFat().exists(CONFIG_TRIGGER_PATH);
    if (!hadConfig || forceConfig || usbPowerDetected() || wakeButtonRequestedConfig())
        runConfigMode();

    runFrameMode();
}

void loop()
{
    // Not used. The frame wakes, performs one action, then enters deep sleep.
}
