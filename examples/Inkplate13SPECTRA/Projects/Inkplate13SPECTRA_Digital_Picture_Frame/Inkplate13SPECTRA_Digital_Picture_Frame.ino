static const uint8_t BIN_MAGIC[8] = {'I', 'P', '1', '3', 'S', 'P', '6', 'B'};

void copyString(char *dst, const char *src, size_t size)
{
    if (size == 0)
        return;
    strncpy(dst, src ? src : "", size - 1);
    dst[size - 1] = '\0';
}

uint16_t readLe16(const uint8_t *p)
{
    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
}

uint32_t readLe32(const uint8_t *p)
{
    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
}

void setDefaultConfig()
{
    memset(&config, 0, sizeof(config));
    copyString(config.photoDir, DEFAULT_PHOTO_DIR, sizeof(config.photoDir));
    config.shuffle = true;
    config.updateMinutes = 60;
    config.syncEveryUpdates = 24;
    config.lowBatteryVoltage = 3.45f;
    config.lastIndex = 0;
}

void normalizePhotoDir()
{
    String path = config.photoDir;
    path.trim();
    if (path.length() == 0)
        path = DEFAULT_PHOTO_DIR;
    if (!path.startsWith("/"))
        path = "/" + path;
    while (path.length() > 1 && path.endsWith("/"))
        path.remove(path.length() - 1);
    copyString(config.photoDir, path.c_str(), sizeof(config.photoDir));
}

void ensureStorage()
{
    SdFat &sd = display.getSdFat();
    sd.mkdir("/frame", true);
    normalizePhotoDir();
    sd.mkdir(config.photoDir, true);
}

bool loadConfig()
{
    setDefaultConfig();

    SdFile file;
    if (!file.open(CONFIG_PATH, O_RDONLY))
        return false;

    size_t len = file.fileSize();
    if (len == 0 || len > 4096)
    {
        file.close();
        return false;
    }

    char *json = (char *)malloc(len + 1);
    if (!json)
    {
        file.close();
        return false;
    }

    file.read(json, len);
    json[len] = '\0';
    file.close();

    DynamicJsonDocument doc(4096);
    DeserializationError err = deserializeJson(doc, json);
    free(json);
    if (err)
        return false;

    copyString(config.wifiSsid, doc["wifi"]["ssid"] | "", sizeof(config.wifiSsid));
    copyString(config.wifiPassword, doc["wifi"]["password"] | "", sizeof(config.wifiPassword));
    const char *scriptUrl = doc["web"]["script_url"] | "";
    if (scriptUrl[0] == '\0')
        scriptUrl = doc["web"]["manifest_url"] | "";
    copyString(config.scriptUrl, scriptUrl, sizeof(config.scriptUrl));
    copyString(config.syncToken, doc["web"]["sync_token"] | "", sizeof(config.syncToken));
    copyString(config.photoDir, doc["display"]["photo_dir"] | DEFAULT_PHOTO_DIR, sizeof(config.photoDir));
    config.shuffle = doc["display"]["shuffle"] | true;
    config.updateMinutes = doc["display"]["update_minutes"] | 60;
    config.syncEveryUpdates = doc["web"]["sync_every_updates"] | 24;
    if (config.syncEveryUpdates == 0)
        config.syncEveryUpdates = 1;
    config.lowBatteryVoltage = doc["power"]["low_battery_voltage"] | 3.45f;
    config.lastIndex = doc["state"]["last_index"] | 0;
    normalizePhotoDir();
    return true;
}

bool saveConfig()
{
    SdFat &sd = display.getSdFat();
    ensureStorage();

    DynamicJsonDocument doc(4096);
    doc["wifi"]["ssid"] = config.wifiSsid;
    doc["wifi"]["password"] = config.wifiPassword;
    doc["web"]["script_url"] = config.scriptUrl;
    doc["web"]["sync_token"] = config.syncToken;
    doc["web"]["sync_every_updates"] = config.syncEveryUpdates;
    doc["display"]["photo_dir"] = config.photoDir;
    doc["display"]["shuffle"] = config.shuffle;
    doc["display"]["update_minutes"] = config.updateMinutes;
    doc["power"]["low_battery_voltage"] = config.lowBatteryVoltage;
    doc["state"]["last_index"] = config.lastIndex;

    sd.remove(CONFIG_PATH);
    SdFile file;
    if (!file.open(CONFIG_PATH, O_WRONLY | O_CREAT | O_TRUNC))
        return false;
    serializeJsonPretty(doc, file);
    file.close();
    return true;
}

String htmlEscape(String value)
{
    value.replace("&", "&amp;");
    value.replace("\"", "&quot;");
    value.replace("'", "&#39;");
    value.replace("<", "&lt;");
    value.replace(">", "&gt;");
    return value;
}

String urlEncode(const String &value)
{
    const char hex[] = "0123456789ABCDEF";
    String encoded;
    for (size_t i = 0; i < value.length(); ++i)
    {
        uint8_t c = value[i];
        if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~')
        {
            encoded += (char)c;
        }
        else
        {
            encoded += '%';
            encoded += hex[c >> 4];
            encoded += hex[c & 0x0F];
        }
    }
    return encoded;
}

String buildScriptUrl(const char *mode, const String &id = "")
{
    String url = config.scriptUrl;
    url.trim();
    if (url.length() == 0)
        return "";

    if (url.indexOf('?') < 0)
        url += "?";
    else if (!url.endsWith("?") && !url.endsWith("&"))
        url += "&";

    url += "mode=";
    url += mode;
    url += "&token=";
    url += urlEncode(config.syncToken);
    if (id.length())
    {
        url += "&id=";
        url += urlEncode(id);
    }
    return url;
}

String joinPath(const char *dir, const String &name)
{
    String path(dir);
    if (!path.endsWith("/"))
        path += "/";
    path += name;
    return path;
}

String photoRoot()
{
    String root = config.photoDir;
    root.trim();
    while (root.length() > 1 && root.endsWith("/"))
        root.remove(root.length() - 1);
    return root;
}

bool hasSupportedExtension(String name)
{
    name.toLowerCase();
    return name.endsWith(".bin") || name.endsWith(".jpg") || name.endsWith(".jpeg") || name.endsWith(".png") ||
           name.endsWith(".bmp");
}

String sanitizeFilename(String name, uint16_t fallbackIndex)
{
    int query = name.indexOf('?');
    if (query >= 0)
        name.remove(query);
    int slash = name.lastIndexOf('/');
    if (slash >= 0)
        name = name.substring(slash + 1);
    name.trim();

    if (name.length() == 0 || !hasSupportedExtension(name))
        name = "photo_" + String(fallbackIndex) + ".jpg";

    String out;
    for (size_t i = 0; i < name.length() && out.length() < 60; ++i)
    {
        char c = name[i];
        if (isalnum(c) || c == '.' || c == '_' || c == '-')
            out += c;
        else
            out += '_';
    }
    return out;
}

String sanitizePathSegment(String segment)
{
    segment.trim();
    if (segment == "." || segment == "..")
        return "";

    String out;
    for (size_t i = 0; i < segment.length() && out.length() < 60; ++i)
    {
        char c = segment[i];
        if (isalnum(c) || c == '.' || c == '_' || c == '-' || c == ' ' || c == '(' || c == ')')
            out += c;
        else
            out += '_';
    }
    out.trim();
    return out;
}

String normalizeManagedPath(String input, bool allowRoot)
{
    String root = photoRoot();
    String raw = input;
    raw.replace('\\', '/');
    raw.trim();
    if (raw.length() == 0)
        raw = root;

    String rel;
    if (raw == root)
    {
        rel = "";
    }
    else if (raw.startsWith(root + "/"))
    {
        rel = raw.substring(root.length() + 1);
    }
    else
    {
        while (raw.startsWith("/"))
            raw.remove(0, 1);
        rel = raw;
    }

    String out = root;
    while (rel.length())
    {
        int slash = rel.indexOf('/');
        String segment = slash >= 0 ? rel.substring(0, slash) : rel;
        rel = slash >= 0 ? rel.substring(slash + 1) : "";

        segment.trim();
        if (segment.length() == 0 || segment == ".")
            continue;
        if (segment == "..")
            return "";

        String safe = sanitizePathSegment(segment);
        if (safe.length() == 0)
            return "";
        out += "/";
        out += safe;
    }

    if (!allowRoot && out == root)
        return "";
    return out;
}

String sanitizeUploadFilename(String filename)
{
    filename.replace('\\', '/');
    int slash = filename.lastIndexOf('/');
    if (slash >= 0)
        filename = filename.substring(slash + 1);
    int query = filename.indexOf('?');
    if (query >= 0)
        filename.remove(query);
    filename.trim();

    if (!hasSupportedExtension(filename))
        return "";

    String safe = sanitizePathSegment(filename);
    if (!hasSupportedExtension(safe))
        return "";
    return safe;
}

void showStatus(const String &title, const String &line1 = "", const String &line2 = "", const String &line3 = "")
{
    display.clearDisplay();
    display.setTextColor(INKPLATE_BLACK);
    display.setTextSize(4);
    display.setCursor(40, 60);
    display.println(title);
    display.setTextSize(2);
    display.setCursor(40, 150);
    if (line1.length())
        display.println(line1);
    if (line2.length())
        display.println(line2);
    if (line3.length())
