}

bool usbPowerDetected()
{
#if USB_POWER_DETECT_PIN >= 0
    pinMode(USB_POWER_DETECT_PIN, INPUT);
    return digitalRead(USB_POWER_DETECT_PIN) == USB_POWER_ACTIVE_LEVEL;
#elif defined(ARDUINO_USB_CDC_ON_BOOT) && ARDUINO_USB_CDC_ON_BOOT
    uint32_t start = millis();
    while (millis() - start < 2500)
    {
        if (Serial)
            return true;
        delay(10);
    }
#endif
    return false;
}

bool wakeButtonPressed()
{
    pinMode(WAKE_BUTTON_PIN, INPUT);
    return digitalRead(WAKE_BUTTON_PIN) == WAKE_BUTTON_ACTIVE_LEVEL;
}

bool wakeButtonRequestedConfig()
{
    return esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_EXT0 || wakeButtonPressed();
}

bool connectWiFi(uint32_t timeoutMs)
{
    if (strlen(config.wifiSsid) == 0)
        return false;
    if (WiFi.status() == WL_CONNECTED)
        return true;

    WiFi.mode(WIFI_STA);
    WiFi.begin(config.wifiSsid, config.wifiPassword);

    uint32_t start = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs)
        delay(250);
    return WiFi.status() == WL_CONNECTED;
}

void scanPhotosInDir(const String &dirPath, uint8_t depth)
{
    if (photoCount >= MAX_PHOTOS || depth > 5)
        return;

    SdFile dir;
    if (!dir.open(dirPath.c_str(), O_RDONLY) || !dir.isDir())
    {
        dir.close();
        return;
    }

    SdFile entry;
    while (photoCount < MAX_PHOTOS && entry.openNext(&dir, O_RDONLY))
    {
        char name[96];
        if (!entry.getName(name, sizeof(name)))
        {
            entry.close();
            continue;
        }

        String childPath = joinPath(dirPath.c_str(), String(name));
        bool isDirectory = entry.isDir();
        if (!isDirectory && hasSupportedExtension(String(name)))
            photoList[photoCount++] = childPath;
        entry.close();

        if (isDirectory)
            scanPhotosInDir(childPath, depth + 1);
    }
    dir.close();
}

uint16_t scanPhotos()
{
    photoCount = 0;
    scanPhotosInDir(photoRoot(), 0);
    return photoCount;
}

bool deleteManagedFile(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0 || !hasSupportedExtension(managed))
        return false;

    SdFile file;
    if (!file.open(managed.c_str(), O_RDONLY) || file.isDir())
    {
        file.close();
        return false;
    }
    file.close();
    return display.getSdFat().remove(managed.c_str());
}

bool createManagedFolder(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0)
        return false;
    return display.getSdFat().mkdir(managed.c_str(), true);
}

bool deleteManagedFolder(const String &path)
{
    String managed = normalizeManagedPath(path, false);
    if (managed.length() == 0)
        return false;

    SdFile folder;
    if (!folder.open(managed.c_str(), O_RDONLY) || !folder.isDir())
    {
        folder.close();
        return false;
    }

    bool ok = folder.rmRfStar();
    if (!ok)
        folder.close();
    return ok;
}

void appendFileManagerRows(String &html, const String &dirPath, uint8_t depth, uint16_t &rows)
{
    if (rows >= 200 || depth > 5)
        return;

    SdFile dir;
    if (!dir.open(dirPath.c_str(), O_RDONLY) || !dir.isDir())
    {
        dir.close();
        return;
    }

    SdFile entry;
    while (rows < 200 && entry.openNext(&dir, O_RDONLY))
    {
        char name[96];
        if (!entry.getName(name, sizeof(name)))
        {
            entry.close();
            continue;
        }

        String childPath = joinPath(dirPath.c_str(), String(name));
        String indent;
        for (uint8_t i = 0; i < depth; ++i)
            indent += "&nbsp;&nbsp;&nbsp;";

        html += "<tr><td>";
        html += indent;
        html += entry.isDir() ? "Folder " : "File ";
        html += htmlEscape(name);
        html += "</td><td>";
        if (entry.isDir())
        {
            html += "-";
        }
        else
        {
            html += String(entry.fileSize());
            html += " bytes";
        }
        html += "</td><td>";
        if (entry.isDir())
        {
            html += "<form method='POST' action='/delete_folder' onsubmit=\"return confirm('Delete folder and contents?')\">";
            html += "<input type='hidden' name='path' value='" + htmlEscape(childPath) + "'>";
            html += "<button type='submit'>Delete folder</button></form>";
        }
        else if (hasSupportedExtension(String(name)))
        {
            html += "<form method='POST' action='/delete_file' onsubmit=\"return confirm('Delete file?')\">";
            html += "<input type='hidden' name='path' value='" + htmlEscape(childPath) + "'>";
            html += "<button type='submit'>Delete file</button></form>";
        }
        html += "</td></tr>";
        rows++;

        bool isDirectory = entry.isDir();
        entry.close();
        if (isDirectory)
            appendFileManagerRows(html, childPath, depth + 1, rows);
    }

    dir.close();
}

bool drawBinFromSd(const char *path)
{
    SdFile file;
    if (!file.open(path, O_RDONLY))
        return false;

    uint8_t header[32];
    if (file.read(header, sizeof(header)) != (int)sizeof(header))
    {
        file.close();
        return false;
    }

    const uint32_t expectedBytes = (uint32_t)E_INK_WIDTH * (uint32_t)E_INK_HEIGHT / 2;
    bool ok = memcmp(header, BIN_MAGIC, sizeof(BIN_MAGIC)) == 0 && header[8] == 1 && readLe16(header + 16) == E_INK_WIDTH &&
              readLe16(header + 18) == E_INK_HEIGHT && readLe32(header + 20) == expectedBytes;

    if (!ok)
    {
        file.close();
        return false;
    }

    uint32_t copied = 0;
    uint8_t chunk[2048];
    while (copied < expectedBytes)
    {
        size_t toRead = expectedBytes - copied;
        if (toRead > sizeof(chunk))
            toRead = sizeof(chunk);
        int got = file.read(chunk, toRead);
        if (got <= 0)
        {
            file.close();
            return false;
        }
        memcpy(display.DMemory4Bit + copied, chunk, got);
        copied += got;
    }

    file.close();
    return true;
}

bool drawCommonImageFromSd(const char *path)
{
    String lower(path);
    lower.toLowerCase();
    if (lower.endsWith(".jpg") || lower.endsWith(".jpeg"))
        return display.image.draw(path, ImageColor::JPG, 0, 0, true, false);
    if (lower.endsWith(".png"))
        return display.image.draw(path, ImageColor::PNG, 0, 0, true, false);
    if (lower.endsWith(".bmp"))
        return display.image.draw(path, ImageColor::BMP, 0, 0, true, false);
    return false;
}

bool displayPhoto(const String &path)
{
    Serial.print("Displaying ");
    Serial.println(path);

    display.clearDisplay();
    bool ok = false;
    String lower(path);
    lower.toLowerCase();
    if (lower.endsWith(".bin"))
        ok = drawBinFromSd(path.c_str());
    else
        ok = drawCommonImageFromSd(path.c_str());

    if (ok)
        display.display();
    return ok;
}

bool downloadFile(const String &url, const String &path)
{
    HTTPClient http;
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    if (!http.begin(url))
        return false;

    int code = http.GET();
    if (code != HTTP_CODE_OK)
    {
        Serial.printf("Download HTTP %d: %s\n", code, url.c_str());
        http.end();
        return false;
    }

    String tmpPath = path + ".tmp";
    SdFat &sd = display.getSdFat();
    sd.remove(tmpPath.c_str());

    SdFile out;
    if (!out.open(tmpPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC))
    {
        http.end();
        return false;
    }

    WiFiClient *stream = http.getStreamPtr();
    int32_t remaining = http.getSize();
    uint8_t buffer[2048];
    uint32_t lastData = millis();
    bool ok = true;

    while (http.connected() && (remaining > 0 || remaining == -1))
    {
        size_t available = stream->available();
        if (available)
        {
            size_t toRead = available > sizeof(buffer) ? sizeof(buffer) : available;
            int got = stream->readBytes(buffer, toRead);
            if (got > 0)
            {
                out.write(buffer, got);
                if (remaining > 0)
                    remaining -= got;
                lastData = millis();
            }
        }
        else
        {
            if (millis() - lastData > DOWNLOAD_IDLE_TIMEOUT_MS)
            {
                ok = false;
                break;
            }
            delay(2);
        }
    }

    out.close();
    http.end();

    if (!ok || remaining > 0)
    {
        sd.remove(tmpPath.c_str());
        return false;
    }

    sd.remove(path.c_str());
    return sd.rename(tmpPath.c_str(), path.c_str());
}

int8_t base64Value(char c)
{
    if (c >= 'A' && c <= 'Z')
        return c - 'A';
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 26;
    if (c >= '0' && c <= '9')
        return c - '0' + 52;
    if (c == '+')
        return 62;
    if (c == '/')
        return 63;
    if (c == '=')
        return 64;
    if (c == '\r' || c == '\n' || c == ' ' || c == '\t')
        return -2;
    return -1;
}

bool writeBase64Char(SdFile &out, char c, uint8_t quartet[4], uint8_t &quartetLen)
{
    int8_t value = base64Value(c);
    if (value == -2)
        return true;
    if (value < 0)
        return false;

    quartet[quartetLen++] = value;
    if (quartetLen < 4)
        return true;

    if (quartet[0] == 64 || quartet[1] == 64 || (quartet[2] == 64 && quartet[3] != 64))
    {
        quartetLen = 0;
        return false;
    }

    uint8_t decoded[3];
    decoded[0] = (quartet[0] << 2) | (quartet[1] >> 4);
    decoded[1] = ((quartet[1] & 0x0F) << 4) | (quartet[2] >> 2);
    decoded[2] = ((quartet[2] & 0x03) << 6) | quartet[3];

    uint8_t count = 3;
    if (quartet[2] == 64)
        count = 1;
    else if (quartet[3] == 64)
        count = 2;

    out.write(decoded, count);
    quartetLen = 0;
    return true;
}

bool downloadBase64File(const String &url, const String &path)
{
    HTTPClient http;
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    if (!http.begin(url))
        return false;

    int code = http.GET();
    if (code != HTTP_CODE_OK)
    {
        Serial.printf("Base64 download HTTP %d\n", code);
        http.end();
        return false;
    }

    String tmpPath = path + ".tmp";
    SdFat &sd = display.getSdFat();
    sd.remove(tmpPath.c_str());

    SdFile out;
    if (!out.open(tmpPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC))
    {
        http.end();
        return false;
    }

    WiFiClient *stream = http.getStreamPtr();
    int32_t remaining = http.getSize();
    uint8_t input[2048];
    uint8_t quartet[4] = {0};
    uint8_t quartetLen = 0;
    uint32_t lastData = millis();
    bool ok = true;

    while (http.connected() && (remaining > 0 || remaining == -1))
    {
        size_t available = stream->available();
        if (available)
        {
            size_t toRead = available > sizeof(input) ? sizeof(input) : available;
            int got = stream->readBytes(input, toRead);
            if (got > 0)
            {
                for (int i = 0; i < got; ++i)
                {
                    if (!writeBase64Char(out, (char)input[i], quartet, quartetLen))
                    {
                        ok = false;
                        break;
                    }
                }
                if (!ok)
                    break;
                if (remaining > 0)
                    remaining -= got;
                lastData = millis();
            }
        }
        else
        {
            if (millis() - lastData > DOWNLOAD_IDLE_TIMEOUT_MS)
            {
                ok = false;
                break;
            }
            delay(2);
        }
    }

    if (quartetLen != 0)
        ok = false;

    out.close();
    http.end();

    if (!ok || remaining > 0)
    {
        sd.remove(tmpPath.c_str());
        return false;
    }

    sd.remove(path.c_str());
    return sd.rename(tmpPath.c_str(), path.c_str());
}

void loadSyncState(DynamicJsonDocument &stateDoc)
{
    SdFile file;
    if (file.open(SYNC_STATE_PATH, O_RDONLY))
    {
        DeserializationError err = deserializeJson(stateDoc, file);
        file.close();
        if (!err && stateDoc["photos"].is<JsonArray>())
            return;
    }

    stateDoc.clear();
    stateDoc.createNestedArray("photos");
}

bool saveSyncState(DynamicJsonDocument &stateDoc)
{
    SdFat &sd = display.getSdFat();
    sd.remove(SYNC_STATE_PATH);
    SdFile file;
    if (!file.open(SYNC_STATE_PATH, O_WRONLY | O_CREAT | O_TRUNC))
        return false;
    serializeJsonPretty(stateDoc, file);
    file.close();
    return true;
}

JsonObject findStateEntry(JsonArray statePhotos, const String &id)
{
    for (JsonVariant value : statePhotos)
    {
        JsonObject entry = value.as<JsonObject>();
        if (String(entry["id"] | "") == id)
            return entry;
    }
    return JsonObject();
}

bool localFileMatches(const String &path, uint32_t expectedSize)
{
    SdFile file;
    if (!file.open(path.c_str(), O_RDONLY))
        return false;
    uint32_t actualSize = file.fileSize();
    file.close();
    return actualSize == expectedSize;
}

bool stateMatches(JsonObject state, const String &name, const String &modified, uint32_t size)
{
    if (state.isNull())
        return false;
    return String(state["name"] | "") == name && String(state["modified"] | "") == modified &&
           ((uint32_t)(state["size"] | 0)) == size;
}

void recordSyncState(JsonArray statePhotos, const String &id, const String &name, const String &modified, uint32_t size)
{
    JsonObject item = statePhotos.createNestedObject();
    item["id"] = id;
    item["name"] = name;
    item["modified"] = modified;
    item["size"] = size;
}

String filenameFromUrl(const String &url, uint16_t index)
{
    return sanitizeFilename(url, index);
}

uint16_t syncFromDriveFolder()
{
    if (strlen(config.scriptUrl) == 0)
    {
        lastWebMessage = "No Apps Script URL configured.";
        return 0;
    }
    if (strlen(config.syncToken) == 0)
    {
        lastWebMessage = "No sync token configured.";
        return 0;
    }
    if (!connectWiFi(WIFI_TIMEOUT_MS))
    {
        lastWebMessage = "WiFi connection failed.";
        return 0;
    }

    showStatus("Syncing photos", "Reading Google Drive manifest...");

    HTTPClient http;
    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    String requestUrl = buildScriptUrl("manifest");
    if (!http.begin(requestUrl))
    {
        lastWebMessage = "Could not open Apps Script URL.";
        return 0;
    }

    int code = http.GET();
    if (code != HTTP_CODE_OK)
    {
        lastWebMessage = "Manifest HTTP error " + String(code);
        http.end();
        return 0;
    }

    DynamicJsonDocument doc(32768);
    DeserializationError err = deserializeJson(doc, *http.getStreamPtr());
    http.end();
    if (err)
    {
        lastWebMessage = "Manifest JSON parse failed.";
        return 0;
    }

    JsonArray photos;
    if (doc.is<JsonArray>())
        photos = doc.as<JsonArray>();
    else
        photos = doc["photos"].as<JsonArray>();

    if (photos.isNull())
    {
        lastWebMessage = "Manifest must be an array or contain photos[].";
        return 0;
    }

    ensureStorage();
    DynamicJsonDocument stateDoc(32768);
    DynamicJsonDocument newStateDoc(32768);
    loadSyncState(stateDoc);
    JsonArray oldState = stateDoc["photos"].as<JsonArray>();
    JsonArray newState = newStateDoc.createNestedArray("photos");

    uint16_t downloaded = 0;
    uint16_t skipped = 0;
    uint16_t failed = 0;
    uint16_t seen = 0;

    for (JsonVariant item : photos)
    {
        if (seen >= MAX_MANIFEST_ITEMS)
            break;
        seen++;

        if (!item.is<JsonObject>())
            continue;

        String id = item["id"] | "";
        String url;
        String name = item["name"] | "";
        String modified = item["modified"] | "";
        uint32_t remoteSize = item["size"] | 0;

        if (name.length() == 0)
            name = id.length() ? ("drive_" + id + ".jpg") : filenameFromUrl(url, seen);
        name = sanitizeFilename(name, seen);
        if (!hasSupportedExtension(name))
            continue;

        String target = joinPath(config.photoDir, name);
        JsonObject oldEntry = findStateEntry(oldState, id);
        bool unchanged = id.length() > 0 && remoteSize > 0 && localFileMatches(target, remoteSize) &&
                         stateMatches(oldEntry, name, modified, remoteSize);

        if (unchanged)
        {
            skipped++;
            recordSyncState(newState, id, name, modified, remoteSize);
            continue;
        }

        showStatus("Syncing photos", "Downloading " + name,
                   String(downloaded) + " saved, " + String(skipped) + " unchanged");

        bool ok = false;
        url = item["url"] | "";
        if (url.length())
            ok = downloadFile(url, target);
        else if (id.length())
            ok = downloadBase64File(buildScriptUrl("file", id), target);

        if (ok && remoteSize > 0 && !localFileMatches(target, remoteSize))
        {
            display.getSdFat().remove(target.c_str());
            ok = false;
        }

        if (ok)
        {
            downloaded++;
            recordSyncState(newState, id, name, modified, remoteSize);
        }
        else
        {
            failed++;
        }
    }

    saveSyncState(newStateDoc);
    WiFi.mode(WIFI_OFF);
    lastWebMessage = "Downloaded " + String(downloaded) + ", skipped " + String(skipped) + ", failed " +
                     String(failed) + " of " + String(seen) + " Drive items.";
    return downloaded;
}

void sleepForMinutes(uint32_t minutes)
{
    if (minutes == 0)
        minutes = 1;
    display.sdCardSleep();
    WiFi.mode(WIFI_OFF);
    esp_sleep_enable_timer_wakeup((uint64_t)minutes * 60ULL * 1000000ULL);
    esp_sleep_enable_ext0_wakeup(WAKE_BUTTON_PIN, WAKE_BUTTON_ACTIVE_LEVEL);
    esp_deep_sleep_start();
}

void handleLowBattery(float voltage)
{
    showStatus("Battery low", "Please charge the Inkplate.", "Battery: " + String(voltage, 2) + " V");
    sleepForMinutes(360);
}

void runFrameMode()
{
    float voltage = display.readBattery();
    if (voltage > 1.0f && voltage < config.lowBatteryVoltage)
        handleLowBattery(voltage);

    if (!syncCounterInitialized)
    {
        updatesSinceLastSync = config.syncEveryUpdates;
        syncCounterInitialized = true;
    }
    else if (updatesSinceLastSync < UINT32_MAX)
    {
        updatesSinceLastSync++;
    }

    scanPhotos();
    bool syncConfigured = strlen(config.scriptUrl) > 0 && strlen(config.syncToken) > 0 && strlen(config.wifiSsid) > 0;
    bool shouldSync = syncConfigured && (photoCount == 0 || updatesSinceLastSync >= config.syncEveryUpdates);
    if (shouldSync)
    {
        syncFromDriveFolder();
        updatesSinceLastSync = 0;
        scanPhotos();
    }

    if (photoCount == 0)
    {
        showStatus("No photos found", String("Copy JPG, PNG, BMP, or BIN files to ") + config.photoDir,
                   "Or use USB/config mode to sync.");
        sleepForMinutes(config.updateMinutes);
    }

    randomSeed(micros());
    uint16_t start = config.shuffle ? random(photoCount) : (config.lastIndex % photoCount);
    bool shown = false;

    for (uint16_t attempt = 0; attempt < photoCount && !shown; ++attempt)
    {
        uint16_t index = (start + attempt) % photoCount;
        shown = displayPhoto(photoList[index]);
        if (shown && !config.shuffle)
        {
            config.lastIndex = (index + 1) % photoCount;
            saveConfig();
        }
    }

    if (!shown)
        showStatus("Image error", "No supported photos could be displayed.", config.photoDir);

    sleepForMinutes(config.updateMinutes);
}

