    copyString(config.photoDir, DEFAULT_PHOTO_DIR, sizeof(config.photoDir));
    config.shuffle = true;
    config.updateMinutes = 60;
    config.syncEveryUpdates = 24;
    config.lowBatteryVoltage = 3.45f;
    config.lastIndex = 0;
}

void normalizePhotoDir()
{
    String path = config.photoDir;
    path.trim();
    if (path.length() == 0)
        path = DEFAULT_PHOTO_DIR;
    if (!path.startsWith("/"))
        path = "/" + path;
    while (path.length() > 1 && path.endsWith("/"))
        path.remove(path.length() - 1);
    copyString(config.photoDir, path.c_str(), sizeof(config.photoDir));
}

void ensureStorage()
{
    SdFat &sd = display.getSdFat();
    sd.mkdir("/frame", true);
    normalizePhotoDir();
    sd.mkdir(config.photoDir, true);
}

String redactUrlToken(String url)
{
    int tokenStart = url.indexOf("token=");
    if (tokenStart < 0)
        return url;

    int valueStart = tokenStart + 6;
    int valueEnd = url.indexOf('&', valueStart);
    if (valueEnd < 0)
        valueEnd = url.length();
    return url.substring(0, valueStart) + "REDACTED" + url.substring(valueEnd);
}

